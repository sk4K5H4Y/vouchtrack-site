---
// Site header: the one copy every page uses. `active` marks the current section.
interface Props { active?: "how" | "whatwedo" | "industries" | "pricing" | "tools" | ""; }
const { active = "" } = Astro.props;
const trig = (k: string) => (active === k ? "menu-trigger active" : "menu-trigger");
const top = (k: string) => (active === k ? "active" : undefined);
---
<header>
  <div class="wrap nav">
    <a href="/" class="logo"><svg class="logo-mark" width="26" height="31" viewBox="0 0 34 40" aria-hidden="true"><path class="lm-pin" d="M17 1C8.2 1 1 8 1 16.6 1 28 17 39 17 39s16-11 16-22.4C33 8 25.8 1 17 1z"/><path class="lm-star" d="M17 7.5l2.6 5.3 5.8.8-4.2 4 1 5.7L17 20.6l-5.2 2.7 1-5.7-4.2-4 5.8-.8z"/></svg>VouchTrack</a>
    <button class="menu-toggle" aria-label="Open menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>
    <ul class="nav-links">
      <li><a href="/how-it-works" class={top("how")}>How it works</a></li>
      <li class="has-menu">
        <a href="/features/ai-search" class={trig("whatwedo")}>What we do <span class="caret" aria-hidden="true">&#9662;</span></a>
        <div class="nav-menu menu-panel">
          <div class="menu-col">
            <div class="menu-group-label">See where you stand</div>
            <ul>
              <li><a href="/features/ai-search">AI visibility tracking</a></li>
              <li><a href="/how-ai-picks-local-businesses">How AI picks local businesses</a></li>
              <li><a href="/features/aeo-content">Content &amp; profile work</a></li>
              <li><a href="https://app.vouchtrack.com/intel-request" target="_blank" rel="noopener noreferrer" data-cta="report">Free visibility report</a></li>
            </ul>
          </div>
          <div class="menu-col">
            <div class="menu-group-label">The review engine</div>
            <ul>
              <li><a href="/features/review-requests">Review requests</a></li>
              <li><a href="/features/ai-replies">AI-written replies</a></li>
              <li><a href="/features/review-inbox">Review inbox</a></li>
              <li><a href="/features/website-widgets">Widgets &amp; testimonials</a></li>
              <li><a href="/features/insights-rankings">Rank tracking</a></li>
            </ul>
          </div>
          <div class="menu-all"><a href="/features">All features &rarr;</a></div>
        </div>
      </li>
      <li class="has-menu">
        <a href="/industries" class={trig("industries")}>Industries <span class="caret" aria-hidden="true">&#9662;</span></a>
        <ul class="nav-menu two-col">
          <li><a href="/industries/hair-salons">Hair salons</a></li>
          <li><a href="/industries/dental">Dental offices</a></li>
          <li><a href="/industries/nail-salons-spas">Nail salons &amp; spas</a></li>
          <li><a href="/industries/restaurants">Restaurants</a></li>
          <li><a href="/industries/med-spas">Med spas</a></li>
          <li><a href="/industries/hvac-home-services">HVAC &amp; home services</a></li>
          <li><a href="/industries/auto-repair">Auto repair</a></li>
          <li><a href="/industries/plumbers">Plumbers</a></li>
          <li class="menu-all"><a href="/industries">All 21 industries &rarr;</a></li>
        </ul>
      </li>
      <li><a href="/pricing" class={top("pricing")}>Pricing</a></li>
      <li class="has-menu">
        <a href="/tools" class={trig("tools")}>Free tools <span class="caret" aria-hidden="true">&#9662;</span></a>
        <ul class="nav-menu">
          <li><a href="/tools/review-calculator">Rating revenue calculator</a></li>
          <li><a href="/tools/reviews-needed-calculator">Reviews-needed calculator</a></li>
          <li><a href="/tools/review-qr-poster">Review QR poster maker</a></li>
          <li><a href="/tools/review-request-templates">Review request templates</a></li>
          <li><a href="/tools/review-policy-quiz">Review policy quiz</a></li>
          <li class="menu-all"><a href="/tools">All free tools &rarr;</a></li>
        </ul>
      </li>
      <li><a href="https://app.vouchtrack.com/login">Sign in</a></li>
      <li><a href="/book" class="btn btn-gold" data-cta="demo" data-loc="nav">Book a free demo</a></li>
    </ul>
  </div>
</header>
